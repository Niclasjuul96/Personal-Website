rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allowed-users list (who can access gated pages on the site).
    // Read is public — this data is already effectively public today
    // (baked into the compiled JS bundle), so no regression there.
    // Write is restricted to the one hardcoded owner email, checked
    // against the *Firebase Auth* session (bridged from the site's own
    // Google login) — not anything the client claims about itself.
    // Must match AllowedUsersService.BOOTSTRAP_OWNER_EMAIL exactly
    // (case-insensitive compare on both sides).
    match /allowedUsers/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email.lower() == 'niclasschaeffer96@gmail.com';
    }

    // Per-project visibility state (live / coming-soon / hidden) for the
    // Portfolio page, editable from the admin UI. Same public-read,
    // owner-only-write shape as allowedUsers above, and the same reasoning:
    // this data was already effectively public (which projects exist is
    // visible in the compiled bundle either way).
    match /projectVisibility/{projectId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email.lower() == 'niclasschaeffer96@gmail.com';
    }

    // Explicit Portfolio project ordering (a single doc holding an ordered
    // list of project ids), editable from the admin UI. Same shape as
    // above — public read, owner-only write.
    match /projectOrder/{orderId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email.lower() == 'niclasschaeffer96@gmail.com';
    }

    // The actual Portfolio project content (title, description, tech
    // stack, links, image URL) — replaces what used to be hardcoded in
    // cv-profile.ts. Same public-read, owner-only-write shape as above.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email.lower() == 'niclasschaeffer96@gmail.com';
    }

    // Everything else stays denied by default (production mode).
  }
}
